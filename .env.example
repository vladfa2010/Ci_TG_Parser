# =============================================
# CITG v2 — Example Environment Variables
# Copy to .env and fill in your values
# =============================================

# ─── Telegram API (get from https://my.telegram.org/apps) ───
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here

# ─── Session (generate locally with: python generate_session.py)
TG_STRING_SESSION=1BQANOTEz...your_session_string...

# ─── PostgreSQL (Render provides this automatically)
DATABASE_URL=postgresql+asyncpg://citg:citg_secret@localhost/citg

# ─── Channels (comma-separated, no @ prefix)
CHANNELS=markettwits,ru2ch,waleburg

# ─── Parser Mode ────────────────────────────────────────────
# HISTORY=1              # Deprecated in v3; history is loaded automatically
# SCHEDULE_MODE=1        # Run continuously with INTERVAL_SEC
# INTERVAL_SEC=300       # 5 minutes between runs
# MAX_CONCURRENT_CHANNELS=5
# RETRY_ATTEMPTS=3

# ─── Backfill (History) Settings ───────────────────────────
# HISTORY_BATCH_SIZE=5000              # Messages per history batch
# HISTORY_MAX_BATCHES_PER_RUN=5        # Batches per channel per run
# HISTORY_MAX_SECONDS_PER_CHANNEL=900  # Max seconds per channel per run

# ─── Web Mode ──────────────────────────────────────────────
# APP_MODE=web           # Set on Render for web dashboard
# PORT=10000             # Render sets this automatically
